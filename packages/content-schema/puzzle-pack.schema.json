{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecture-escape.local/schemas/puzzle-pack.schema.json",
  "title": "Lecture Escape PuzzlePack",
  "type": "object",
  "required": [
    "schemaVersion",
    "video",
    "room",
    "items",
    "puzzles",
    "completion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "video": {
      "$ref": "#/$defs/video"
    },
    "room": {
      "$ref": "#/$defs/room"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "puzzles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/puzzle"
      }
    },
    "completion": {
      "type": "object",
      "required": ["finalPuzzleId", "exitItemId", "effect"],
      "properties": {
        "finalPuzzleId": { "$ref": "#/$defs/id" },
        "exitItemId": { "$ref": "#/$defs/id" },
        "exitObjectId": { "$ref": "#/$defs/id" },
        "effect": { "const": "UNLOCK_EXIT" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "rect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "segment": {
      "type": "object",
      "required": ["id", "startSec", "endSec", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "startSec": { "type": "number", "minimum": 0 },
        "endSec": { "type": "number", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "video": {
      "type": "object",
      "required": ["id", "title", "durationSec", "segments"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "durationSec": { "type": "number", "minimum": 0 },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/segment" }
        }
      },
      "additionalProperties": true
    },
    "navigation": {
      "type": "object",
      "required": ["targetViewId", "label"],
      "properties": {
        "targetViewId": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "rect": { "$ref": "#/$defs/rect" }
      },
      "additionalProperties": true
    },
    "view": {
      "type": "object",
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["OVERVIEW", "CLOSEUP"] },
        "label": { "type": "string", "minLength": 1 },
        "backgroundAssetKey": { "$ref": "#/$defs/id" },
        "backToViewId": { "$ref": "#/$defs/id" },
        "navigation": {
          "type": "array",
          "items": { "$ref": "#/$defs/navigation" }
        }
      },
      "additionalProperties": true
    },
    "room": {
      "type": "object",
      "required": [
        "id",
        "title",
        "initialViewId",
        "declaredPuzzleCount",
        "views"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "theme": { "type": "string" },
        "initialViewId": { "$ref": "#/$defs/id" },
        "declaredPuzzleCount": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/view" }
        }
      },
      "additionalProperties": true
    },
    "itemSource": {
      "type": "object",
      "required": ["type", "viewId"],
      "properties": {
        "type": { "enum": ["SCENE", "PUZZLE_REWARD"] },
        "viewId": { "$ref": "#/$defs/id" },
        "puzzleId": { "$ref": "#/$defs/id" },
        "rect": { "$ref": "#/$defs/rect" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "PUZZLE_REWARD" } }
          },
          "then": { "required": ["puzzleId"] }
        }
      ],
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["id", "label", "assetKey", "description", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "assetKey": { "$ref": "#/$defs/id" },
        "displayText": { "type": "string" },
        "description": { "type": "string", "minLength": 1 },
        "pickupText": { "type": "string" },
        "inventoryDescription": { "type": "string" },
        "consumedOnUse": { "type": "boolean" },
        "source": { "$ref": "#/$defs/itemSource" }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1 },
        "rect": { "$ref": "#/$defs/rect" }
      },
      "additionalProperties": true
    },
    "slot": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "rect": { "$ref": "#/$defs/rect" }
      },
      "additionalProperties": true
    },
    "placement": {
      "type": "object",
      "required": ["slotId", "itemId"],
      "properties": {
        "slotId": { "$ref": "#/$defs/id" },
        "itemId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "required": ["defaultWrongItem", "wrongSlot", "byItemId"],
      "properties": {
        "defaultWrongItem": { "type": "string", "minLength": 1 },
        "wrongSlot": { "type": "string" },
        "byItemId": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    },
    "hint": {
      "type": "object",
      "required": ["level", "type", "text"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "type": { "enum": ["OBSERVATION", "CONCEPT", "DIRECTION"] },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "explanation": {
      "type": "object",
      "required": ["title", "body", "evidenceSegmentIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "evidenceSegmentIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "additionalProperties": false
    },
    "reward": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "itemId"],
          "properties": {
            "type": { "const": "REVEAL_ITEM" },
            "itemId": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["type", "objectId"],
          "properties": {
            "type": { "const": "UNLOCK_EXIT" },
            "objectId": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": true
        }
      ]
    },
    "puzzle": {
      "type": "object",
      "required": [
        "id",
        "order",
        "kind",
        "template",
        "viewId",
        "target",
        "prompt",
        "requiresPuzzleIds",
        "candidateItemIds",
        "slots",
        "solution",
        "feedback",
        "hints",
        "explanation",
        "rewards"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 1, "maximum": 5 },
        "kind": { "const": "ITEM_PLACEMENT" },
        "template": {
          "enum": [
            "MISSING_TOKEN",
            "ORDER_ITEMS",
            "KEY_TO_LOCK",
            "MATCH_ITEM",
            "FINAL_SAFE"
          ]
        },
        "viewId": { "$ref": "#/$defs/id" },
        "target": { "$ref": "#/$defs/target" },
        "learningObjective": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "requiresPuzzleIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "candidateItemIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slot" }
        },
        "solution": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/placement" }
        },
        "feedback": { "$ref": "#/$defs/feedback" },
        "hints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/hint" },
                {
                  "properties": {
                    "level": { "const": 1 },
                    "type": { "const": "OBSERVATION" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/hint" },
                {
                  "properties": {
                    "level": { "const": 2 },
                    "type": { "const": "CONCEPT" }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/hint" },
                {
                  "properties": {
                    "level": { "const": 3 },
                    "type": { "const": "DIRECTION" }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "explanation": { "$ref": "#/$defs/explanation" },
        "rewards": {
          "type": "array",
          "items": { "$ref": "#/$defs/reward" }
        }
      },
      "additionalProperties": true
    }
  }
}
